# Copy to .env.local and fill in. Never commit real keys.
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by the seed script and nightly jobs, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard → Connect → Session pooler connection string (seed script only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
